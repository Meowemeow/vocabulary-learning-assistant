# OpenAI-compatible API configuration
API_KEY=your-api-key
API_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# Optional fallback model. Leave blank to disable fallback.
FALLBACK_MODEL=

# Optional nanobot-compatible endpoint. When configured, it takes precedence.
# NANOBOT_API_URL=http://127.0.0.1:8765/v1
# NANOBOT_API_KEY=your-nanobot-key
# NANOBOT_MODEL=your-nanobot-model

HOST=127.0.0.1
PORT=5000
